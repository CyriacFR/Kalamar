+#ifndef HACTOOL_RANGE_H
+#define HACTOOL_RANGE_H
+
+#include <stdio.h>
+#include <stdint.h>
+
+/* An input that is a byte range of a bigger file: an NCA read where it lies inside its NSP (range.c). */
+void range_from_env(FILE *f, const char *var);
+int range_fseeko64(FILE *f, int64_t off, int whence);
+
+#endif
