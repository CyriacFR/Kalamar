diff --git a/range.c b/range.c
new file mode 100644
index 0000000..c0c05eb
--- /dev/null
+++ b/range.c
@@ -0,0 +1,78 @@
+/* An input file that is a byte range of a bigger file. A merge of a game's RomFS with its update hands hactool the
+   base and update Program NCAs where they lie inside the NSP files, instead of copying them out first (12 GB of
+   writes and of free space for Splatoon 3). HACTOOL_INPUT_RANGE (the input) and HACTOOL_BASENCA_RANGE (--basenca) hold
+   "<offset>:<size>" in decimal bytes. Every seek of hactool goes through range_fseeko64 (utils.h): on a FILE given a
+   range, SEEK_SET counts from the range's start and SEEK_END from its end; SEEK_CUR is relative already. Reads are not
+   clamped: hactool reads an NCA only within the sizes its headers give. */
+#define HACTOOL_RANGE_IMPL
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdint.h>
+#include <inttypes.h>
+#include "range.h"
+
+static int real_seek(FILE *f, int64_t off, int whence) {
+#if defined(_MSC_VER)
+    return _fseeki64(f, off, whence);
+#elif defined(__MINGW32__)
+    return fseeko64(f, off, whence);
+#else
+    return fseeko(f, (off_t)off, whence);
+#endif
+}
+
+#define MAX_RANGES 4
+
+static struct {
+    FILE *file;
+    int64_t start;
+    int64_t size;
+} ranges[MAX_RANGES];
+
+int range_fseeko64(FILE *f, int64_t off, int whence) {
+    for (int i = 0; f != NULL && i < MAX_RANGES; i++) {
+        if (ranges[i].file != f) {
+            continue;
+        }
+        if (whence == SEEK_SET) {
+            return real_seek(f, ranges[i].start + off, SEEK_SET);
+        }
+        if (whence == SEEK_END) {
+            return real_seek(f, ranges[i].start + ranges[i].size + off, SEEK_SET);
+        }
+        break;
+    }
+    return real_seek(f, off, whence);
+}
+
+void range_from_env(FILE *f, const char *var) {
+    const char *v = getenv(var);
+    if (f == NULL || v == NULL || *v == '\0') {
+        return;
+    }
+    char *end = NULL;
+    int64_t start = strtoll(v, &end, 10), size = -1;
+    if (end != v && *end == ':') {
+        const char *s = end + 1;
+        size = strtoll(s, &end, 10);
+        if (end == s) {
+            size = -1;
+        }
+    }
+    if (*end != '\0' || start < 0 || size <= 0) {
+        fprintf(stderr, "Invalid %s: expected <offset>:<size> in bytes\n", var);
+        exit(EXIT_FAILURE);
+    }
+    for (int i = 0; i < MAX_RANGES; i++) {
+        if (ranges[i].file == NULL) {
+            ranges[i].file = f;
+            ranges[i].start = start;
+            ranges[i].size = size;
+            real_seek(f, start, SEEK_SET);
+            printf("%s: in place at offset %" PRId64 ", %" PRId64 " bytes\n", var, start, size);
+            return;
+        }
+    }
+    fprintf(stderr, "Too many input ranges\n");
+    exit(EXIT_FAILURE);
+}
